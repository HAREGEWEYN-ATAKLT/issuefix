generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Review {
  id          String    @id @default(cuid())
  repository  String
  revision    String
  reviewType  String
  status      String    @default("RUNNING")
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  bobRuns     BobRun[]
  findings    Finding[]
}

model BobRun {
  id         String    @id @default(cuid())
  reviewId   String
  status     String    @default("RUNNING")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  rawOutput  String?
  review     Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Finding {
  id           String        @id @default(cuid())
  reviewId     String
  title        String
  description  String
  severity     String
  source       String
  filePath     String
  startLine    Int
  endLine      Int?
  symbol       String?
  status       String        @default("OPEN")
  createdAt    DateTime      @default(now())
  decision     Decision?
  evidences    Evidence[]
  review       Review        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  verification Verification?
}

model Evidence {
  id          String   @id @default(cuid())
  findingId   String
  type        String
  source      String
  location    String?
  status      String
  description String
  createdAt   DateTime @default(now())
  finding     Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  findingId  String   @unique
  result     String
  reason     String
  verifiedAt DateTime @default(now())
  finding    Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
}

model Policy {
  id        String     @id @default(cuid())
  name      String
  version   String
  rules     String
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  decisions Decision[]
}

model Decision {
  id        String   @id @default(cuid())
  findingId String   @unique
  policyId  String
  result    String
  reason    String
  createdAt DateTime @default(now())
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  policy    Policy   @relation(fields: [policyId], references: [id])
}
